{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pluto's Terminals",
  "version": "0.1.25",
  "identifier": "com.plutothedev.terminals",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5310",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pluto's Terminals",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
